# Ejemplo SIN datos privados. Nunca subir .env con credenciales.
# Base PostgreSQL administrada, con TLS configurado por el proveedor.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST:5432/metrotaxi
METRO_ALLOWED_ORIGINS=https://app.tudominio.com
METRO_ALLOWED_HOSTS=api.tudominio.com
# Configura certificado TLS y proxy inverso HTTPS en el hosting de la API.
# Las claves/admin reales se aprovisionan por CLI; NUNCA se incluyen en el frontend.
