# Opcional, se carga antes de iniciar en el entorno. No subir contraseñas ni claves reales.
METRO_HOST=127.0.0.1
METRO_PORT=8765
# Reemplaza con el número REAL de WhatsApp de la central, dígitos sin + ni guiones.
METRO_WHATSAPP_NUMBER=
# Proveedor de mapa configurable (no se permiten claves secretas en la URL)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_MAX_ZOOM=19
# URL pública del BACKEND Metro Taxi, no una página estática de Netlify.
# Para QR reales en móviles debe usar un dominio HTTPS válido.
# NO publicar el servidor local Python/SQLite directamente en Internet.
METRO_PUBLIC_BASE_URL=

# Tiempo de aceptación (segundos); por defecto 120. La caducidad se procesa al consultar API.
METRO_OFFER_SECONDS=120
